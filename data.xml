import android.provider.Settings;
import android.net.Uri;
import com.joaomgcd.taskerm.action.java.JavaCodeException;

/* 
 * Requesting to ignore battery optimizations requires the user to manually 
 * grant the permission in the system settings. 
 */

String packageName = context.getPackageName();

/* 
 * Check if the app already has permission to ignore battery optimizations. 
 * This requires the REQUEST_IGNORE_BATTERY_OPTIMIZATIONS permission in the manifest.
 */
powerManager = context.getSystemService(android.content.Context.POWER_SERVICE);
if (powerManager.isIgnoringBatteryOptimizations(packageName)) {
    tasker.log("Battery optimization is already ignored for this app.");
    return;
}

/* 
 * Create an intent to open the specific system settings page for this app.
 * This is the only way to request this permission without root/adb/shizuku.
 */
intent = new Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS);
intent.setData(Uri.parse("package:" + packageName));
intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);

try {
    context.startActivity(intent);
    tasker.log("Opened battery optimization settings for user action.");
} catch (Exception e) {
    throw new JavaCodeException("Could not open battery settings: " + e.getMessage());
